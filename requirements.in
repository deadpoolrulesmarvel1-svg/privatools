# PDF signature validation for /verify-signature: whether the signed bytes are
# unchanged, whether the signature matches the signer's certificate, and what
# kind of change was saved after signing. services/signature_service.py passes
# an empty trust list and disables fetching, so validation never contacts the
# network and never reaches oscrypto (a transitive dependency whose 1.3.0
# release cannot parse OpenSSL 3.x.10+ version strings). The service imports
# ValidationContext from pyhanko-certvalidator directly, so it is declared too.
pyhanko==0.37.0
pyhanko-certvalidator==0.32.1

# Clerk session verification. Clerk signs its session tokens RS256, so checking
# one needs RSA — which the standard library does not have. PyJWT does the JWT
# work and cryptography does the maths.
#
# Declared together on purpose: pyjwt[crypto] would pull cryptography in as an
# extra, and app/auth/clerk_session.py imports cryptography's exceptions
# directly, so test_declared_dependencies would (rightly) object to it arriving
# as somebody else's transitive dependency.
#
# The alternative was asking Clerk's API to verify each token, which would put
# a network round-trip on every key request and make API key management stop
# working whenever Clerk had an incident.
pyjwt==2.15.0
# Current, not merely patched. 46.x carries 19 known advisories
# (GHSA-537c-gmf6-5ccf among them) and 48.0.1 is only the minimum fix; both
# the audit and the dependency-review job refuse the 46 series outright.
cryptography==50.0.1
